+function readLabels(value: unknown, issues: ValidationIssue[]): string[] | undefined {
+  if (value === undefined) return undefined;
+  if (!Array.isArray(value) || value.some((item) => typeof item !== 'string')) {
+    issues.push({ field: 'labels', message: 'must be an array of strings' });
+    return undefined;
+  }
+  const labels: string[] = [];
+  for (const item of value as string[]) {
+    const label = item.trim().toLowerCase();
+    if (label.length === 0) {
+      issues.push({ field: 'labels', message: 'must not contain empty labels' });
+      return undefined;
+    }
+    if (label.length > MAX_LABEL_LENGTH) {
+      issues.push({ field: 'labels', message: `each label must be at most ${MAX_LABEL_LENGTH} characters` });
+      return undefined;
+    }
+    if (!labels.includes(label)) labels.push(label);
+  }
+  if (labels.length > MAX_LABELS) {
+    issues.push({ field: 'labels', message: `must contain at most ${MAX_LABELS} distinct labels` });
+    return undefined;
+  }
+  return labels;
+}

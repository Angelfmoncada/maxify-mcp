{
  "name": "maxify-mcp",
  "version": "0.1.0",
  "description": "Local MCP server and CLI that compiles budgeted, verifiable code context for Claude Code.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "code-context",
    "typescript",
    "tokens"
  ],
  "homepage": "https://github.com/Angelfmoncada/maxify-mcp#readme",
  "bugs": {
    "url": "https://github.com/Angelfmoncada/maxify-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Angelfmoncada/maxify-mcp.git"
  },
  "author": "Angel (https://github.com/Angelfmoncada)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "maxify": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "node dist/cli.js bench",
    "prepublishOnly": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ignore": "7.0.14",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "vitest": "5.0.5"
  }
}
